# WeatherAPI Configuration (Primary - More accurate)
# Get your free API key from: https://www.weatherapi.com/
PUBLIC_WEATHERAPI_KEY=your_weatherapi_key_here

# OpenWeather API Configuration (Fallback)
# Get your free API key from: https://openweathermap.org/api
PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Backend API Configuration
PUBLIC_API_BASE_URL=http://localhost:3000/api

# Agenda Service API Configuration
PUBLIC_AGENDA_API_BASE_URL=http://localhost:3001/api/agenda